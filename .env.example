# Bizvyra environment variables. Copy to .env.local (never committed) and fill in.
# Every variable is read lazily at request time; the app builds with none set.

# demo = no limits (for judges) | public = free-tier limits on (3 scans per IP per day)
BIZVYRA_MODE=demo

# LLM provider: gemini | openai_compatible (e.g. NVIDIA NIM)
LLM_PROVIDER=
LLM_API_KEY=
# Only for openai_compatible, e.g. the provider's /v1 base URL
LLM_BASE_URL=
# Model IDs. MODEL_FAST: the demo bot and the bot under test.
MODEL_FAST=
# Optional: the LLM judge and the L2 output-guard self-check. Falls back to MODEL_FAST when empty.
MODEL_JUDGE=
# Optional: refines the hardened prompt in /api/fix. When empty, the deterministic hardener is used alone.
MODEL_STRONG=
# Optional, openai_compatible only: set to off to send "reasoning": { "enabled": false } (for reasoning models).
# Leave empty to keep request bodies unchanged.
LLM_REASONING=

# Supabase (server-side only, service role key; never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true when the repo is on a Windows drive (/mnt/...) and the dev server runs in WSL
WATCHPACK_POLLING=
