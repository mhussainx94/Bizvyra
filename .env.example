# Bizvyra environment variables. Copy to .env.local (never committed) and fill in.
# Every variable is read lazily at request time; the app builds with none set.

# demo = no limits (for judges) | public = free-tier limits on (3 scans per IP per day)
BIZVYRA_MODE=demo

# LLM provider: gemini | openai_compatible (e.g. NVIDIA NIM)
LLM_PROVIDER=
LLM_API_KEY=
# Only for openai_compatible, e.g. the provider's /v1 base URL
LLM_BASE_URL=
# Model IDs. MODEL_FAST: the demo bot and the bot under test.
MODEL_FAST=
# Optional: the LLM judge and the L2 output-guard self-check. Falls back to MODEL_FAST when empty.
MODEL_JUDGE=
# Optional: refines the hardened prompt in /api/fix. When empty, the deterministic hardener is used alone.
MODEL_STRONG=
# Optional: set to off to switch off the model's thinking step (faster, cheaper):
#   openai_compatible sends "reasoning": { "enabled": false }; gemini sends generationConfig.thinkingConfig.thinkingBudget = 0
#   (for Flash models; Pro models cannot switch thinking off). Leave empty to keep request bodies unchanged.
LLM_REASONING=
# Optional: scan steps the browser runs at the same time, integer 1-5 (default 3; invalid values use 3).
# Free-tier keys: use 1, together with LLM_REASONING=off.
SCAN_CONCURRENCY=
# Every LLM call is retried on HTTP 429/500/502/503/504 and network failures (up to 3 retries, about 1 s, 2 s, 4 s,
# honouring Retry-After, at most 10 s per wait, 30 s per call in total). There is nothing to configure.

# Optional, UI only: set to true at build time to run the UI on the static sample run instead of the API
# (no API key needed; the pages then say they show sample data). Leave empty for the live demo.
NEXT_PUBLIC_USE_MOCKS=

# Supabase (server-side only, service role key; never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true when the repo is on a Windows drive (/mnt/...) and the dev server runs in WSL
WATCHPACK_POLLING=
